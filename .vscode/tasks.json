{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dev",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "npm",
                "run",
                "dev"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*VITE.*",
                    "endsPattern": ".*Local:.*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}